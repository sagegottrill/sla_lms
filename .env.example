VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Public site URL (no trailing slash). Fallback when not in browser; OAuth uses window.location.origin in production.
# Local: http://localhost:5173   Production: https://connecther.sheleadsafrica.org
# Add these paths in Supabase → Auth → URL Configuration → Redirect URLs:
#   https://connecther.sheleadsafrica.org/auth/callback
#   https://connecther.sheleadsafrica.org/reset-password
#   http://localhost:5173/auth/callback
VITE_SITE_URL=http://localhost:5173

# =============================================================================
# SendGrid (transactional email + campaign automation)
# =============================================================================
# Set in Supabase Dashboard → Edge Functions → Secrets (NEVER in Vite):
#   SENDGRID_API_KEY=SG.your_key_here
#   SENDGRID_FROM_EMAIL=noreply@sheleadsafrica.org
#   SENDGRID_FROM_NAME=She Leads Africa
#
# Deploy: supabase functions deploy send-email
#         supabase functions deploy process-campaigns
# Cron:   Run supabase/setup_pg_cron.sql in Supabase SQL Editor

# =============================================================================
# Paystack (live)
# =============================================================================
# Browser / Vite — public key only (safe to expose in client bundle).
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_public_key_here

# Webhook URL — paste into Paystack Dashboard → Settings → Developer / API → Webhook URL
# (Not a variable in this file; use your project’s Edge Function URL, e.g.)
# https://<project-ref>.supabase.co/functions/v1/paystack-webhook

# Secret key — NEVER put in Vite. Set in:
#   • Supabase Dashboard → Edge Functions → paystack-webhook → Secrets → PAYSTACK_SECRET_KEY
#   • Local: supabase/.env.local (gitignored) when running `supabase functions serve`
#
# supabase/config.toml sets verify_jwt = false for paystack-webhook (Paystack sends HMAC, not a Supabase JWT).

# Admin “Invite user” (User management) calls Edge Function `invite-staff` (service role on server only).
# Deploy (from repo root, linked project): supabase functions deploy invite-staff
# Paystack: supabase functions deploy paystack-webhook
# Uses SUPABASE_SERVICE_ROLE_KEY and SUPABASE_ANON_KEY automatically in hosted Edge Functions.

# =============================================================================
# AI assistant (Edge Function `lms-ai-chat` — OpenAI-compatible /chat/completions)
# =============================================================================
# Never put the provider API key in Vite. Set only in Supabase → Edge Functions → Secrets:
#   AIMIX_API_KEY=sk-...your_key...
#   AIMIX_BASE_URL=https://your-gateway.example.com/anmix/v1
#   AIMIX_MODEL=gpt-4o-mini
# Deploy: supabase functions deploy lms-ai-chat
# If secrets are missing, the in-app chat falls back to built-in FAQ answers.
