# Copy to `.env.local` (gitignored) for local Edge Function runs, e.g.:
#   supabase functions serve paystack-webhook --env-file supabase/.env.local
#
# For production, set the same name in Supabase Dashboard → Edge Functions → Secrets.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here
